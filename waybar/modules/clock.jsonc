{
  "clock": {
    "format": "󰃱 <span size='11pt'>{:%H.%M }</span>",
    "format-alt": "󰃱 <span size='11pt'>{:%d %B %Y}</span>",
    // Must go through dashboard.sh, not `eww open --toggle`: the script targets
    // the focused monitor (the window's :monitor 0 is always the laptop) and
    // recovers from orphaned eww daemons.
    "on-click": "~/.config/hypr/scripts/dashboard.sh toggle",
    "on-click-right": "mode",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  }
}
