configuration {
    show-icons:      true;
    hover-select:    true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    matching:        "fuzzy";
    case-sensitive:  false;
}

@import "colors.rasi"

* {
    font:           "Adwaita Sans 12";
    bg:             @glass;
    bg-element:     transparent;
    bg-selected:    @sel-bg;
    fg:             @on-surface;
    fg-muted:       @muted;
    fg-selected:    #ffffff;
    border-win:     @border-col;
    fg-prompt:      @primary;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            720px;
    background-color: @bg;
    border:           2px;
    border-color:     @border-win;
    border-radius:    30px;
}

mainbox {
    orientation:      vertical;
    background-color: transparent;
    children:         [ "inputbar", "listview" ];
}

/* nav: search on the left, small action buttons (mode tabs) on the right */
inputbar {
    padding:          20px 20px 10px 20px;
    spacing:          8px;
    background-color: transparent;
    children:         [ "prompt", "entry", "mode-switcher" ];
}

prompt {
    background-color: transparent;
    text-color:       @fg-prompt;
}

entry {
    background-color:  transparent;
    text-color:        @fg;
    placeholder:       "Pick an overlay...";
    placeholder-color: @fg-muted;
    padding:           0 10px;
}

mode-switcher {
    background-color: transparent;
    spacing:          8px;
    expand:           false;
}

button {
    padding:          4px 12px;
    border-radius:    10px;
    border:           1px;
    border-color:     @border-win;
    background-color: @bg-element;
    text-color:       @fg-muted;
    cursor:           pointer;
}

button selected {
    background-color: @bg-selected;
    text-color:       @fg-selected;
}

/* body: gif grid */
listview {
    background-color: transparent;
    flow:             horizontal;
    columns:          3;
    lines:            2;
    spacing:          8px;
    padding:          6px 14px 14px 14px;
    fixed-columns:    true;
    cycle:            false;
}

element {
    orientation:      vertical;
    padding:          10px;
    border-radius:    16px;
    spacing:          6px;
    background-color: @bg-element;
    children:         [ element-icon, element-text ];
}

element normal.normal,
element alternate.normal {
    background-color: @bg-element;
}

element selected {
    background-color: @bg-selected;
}

element-icon {
    background-color: transparent;
    size:             160px;
    horizontal-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color:       @fg-muted;
    horizontal-align: 0.5;
}

element selected element-text {
    text-color: @fg-selected;
}
